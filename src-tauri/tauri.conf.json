{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leve",
  "version": "1.2.0",
  "identifier": "dev.leve.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Leve — Editor", "width": 1400, "height": 900, "minWidth": 800, "minHeight": 550, "decorations": false, "devtools": false, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/256x256.png", "icons/icon.ico"] }
}
